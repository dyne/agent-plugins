#!/usr/bin/env bash
# Strict helper for the small Org dialect used by the org-plan skill.
set -Eeuo pipefail

# All Org parsing, validation, transitions, measurement, and publication live
# in the shared Node core.  Keep this Bash entry point only for the existing
# profile-installation commands, whose transactional file setup is unrelated
# to plan lifecycle semantics.
if [[ ${1:-} != prepare-executor && ${1:-} != prepare-supervision ]]; then
  exec node "$(dirname "$0")/org-plan-cli.mjs" "$@"
fi

show_help() {
  # The command example is intentionally literal help text.
  # shellcheck disable=SC2016
  printf '%s\n' \
    'usage: org-plan COMMAND [args]' \
    'commands: validate|next|summary|status|describe|projection|review|l2|measure|set|signal|supervision-start|prepare-executor|prepare-supervision' \
    'run `org-plan COMMAND --help` for exact command arguments'
}
show_command_help() {
  case $1 in
    validate) printf 'usage: org-plan validate PLAN\n' ;;
    next) printf 'usage: org-plan next PLAN {l1|l2|review}\n' ;;
    summary) printf 'usage: org-plan summary PLAN\n' ;;
    status) printf 'usage: org-plan status PLAN\n' ;;
    describe) printf 'usage: org-plan describe PLAN ID\n' ;;
    projection) printf 'usage: org-plan projection PLAN\n' ;;
    review) printf 'usage: org-plan review PLAN L1_ID {REVIEWED|UNREVIEWED}\n' ;;
    l2) printf '%s\n' 'usage: org-plan l2 PLAN L2_ID {WIP|DONE}' '       org-plan l2 PLAN REGEX' ;;
    measure) printf 'usage: org-plan measure {start|checkpoint|finish} PLAN ID SNAPSHOT_JSON\n' ;;
    set) printf 'usage: org-plan set PLAN L1_ID {TODO|WIP|DONE} [--force]\n' ;;
    signal) printf 'usage: org-plan signal PLAN [REASON]\n' ;;
    supervision-start) printf 'usage: org-plan supervision-start PLAN\n' ;;
    prepare-executor)
      printf '%s\n' \
        'usage: org-plan prepare-executor [--model MODEL] [--agents-dir DIR] [--profile-name NAME]' \
        'setup-only: installs or refreshes the executor role profile'
      ;;
    prepare-supervision)
      printf '%s\n' \
        'usage: org-plan prepare-supervision [--executor-model MODEL] [--reviewer-model MODEL] [--agents-dir DIR] [--executor-profile-name NAME] [--reviewer-profile-name NAME]' \
        'setup-only: installs or refreshes supervised role profiles'
      ;;
    *) return 1 ;;
  esac
}
usage() { show_help >&2; exit 2; }
die() { printf '%s: %s\n' "$plan" "$*" >&2; return 1; }
declare -a ids states levels lines titles parents starts ends review_status review_status_count review_lines skills skills_count
declare -A seen field field_value
count=0

parse() {
  plan=$1; [ -r "$plan" ] || die 'unreadable plan'
  ids=() states=() levels=() lines=() titles=() parents=() starts=() ends=(); review_status=() review_status_count=() review_lines=(); skills=() skills_count=(); seen=() field=() field_value=(); count=0
  local line n=0 current=-1 drawer=0 id='' last_l1=-1
  local -a metadata=(TITLE SUBTITLE DATE KEYWORDS)
  declare -A meta=()
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    if [[ $line =~ ^#\+([A-Z]+): ]]; then
      local key=${BASH_REMATCH[1]}; case " ${metadata[*]} " in *" $key "*) meta[$key]=$(( ${meta[$key]:-0} + 1 ));; esac
    fi
    if [[ $line =~ ^(\*+)[[:space:]]+([^[:space:]]+)[[:space:]]+(\[#([ABC])\])[[:space:]]+(.+)$ ]]; then
      local stars state title level
      stars=${BASH_REMATCH[1]}; state=${BASH_REMATCH[2]}; title=${BASH_REMATCH[5]}; level=${#stars}
      (( level <= 2 )) || die "line $n: unsupported heading depth"
      [[ $state =~ ^(TODO|WIP|DONE)$ ]] || die "line $n: invalid state"
      (( current >= 0 )) && ends[$current]=$((n - 1))
      current=$count; count=$((count + 1)); levels[$current]=$level; states[$current]=$state; lines[$current]=$n; titles[$current]=$title; starts[$current]=$n; ends[$current]=0; id=''; drawer=0
      if (( level == 1 )); then last_l1=$current; parents[$current]=-1; else (( last_l1 >= 0 )) || die "line $n: L2 without L1"; parents[$current]=$last_l1; fi
      continue
    elif [[ $line =~ ^\*+ ]]; then die "line $n: malformed executable heading"; fi
    (( current >= 0 )) || continue
    if [[ $line == ':PROPERTIES:' ]]; then (( drawer == 0 )) || die "line $n: malformed property drawer"; drawer=1; continue; fi
    if (( drawer == 1 )); then
      if [[ $line == ':END:' ]]; then drawer=2; continue; fi
      if [[ $line =~ ^:ID:[[:space:]]*(.+)$ ]]; then id=${BASH_REMATCH[1]}; continue; fi
      if [[ $line =~ ^:REVIEW_STATUS:[[:space:]]*(.*)$ ]]; then
        (( levels[$current] == 1 )) || die "line $n: REVIEW_STATUS is only valid on L1 headings"
        review_status_count[$current]=$(( ${review_status_count[$current]:-0} + 1 ))
        (( review_status_count[$current] == 1 )) || die "line $n: duplicate REVIEW_STATUS"
        review_status[$current]=${BASH_REMATCH[1]}
        [[ ${review_status[$current]} =~ ^(UNREVIEWED|REVIEWED)$ ]] || die "line $n: invalid REVIEW_STATUS"
        review_lines[$current]=$n
        continue
      fi
      if [[ $line =~ ^:SKILLS:[[:space:]]*(.*)$ ]]; then
        (( levels[$current] == 1 )) || die "line $n: SKILLS is only valid on L1 headings"
        skills_count[$current]=$(( ${skills_count[$current]:-0} + 1 ))
        (( skills_count[$current] == 1 )) || die "line $n: duplicate SKILLS"
        skills[$current]=${BASH_REMATCH[1]}
        continue
      fi
      if [[ $line =~ ^:(STARTED_AT|UPDATED_AT|COMPLETED_AT|ELAPSED_SECONDS|WEEKLY_REMAINING_START|WEEKLY_REMAINING_CURRENT|WEEKLY_REMAINING_END|WEEKLY_PERCENT_USED|TOKENS_START|TOKENS_CURRENT|TOKENS_END|TOKENS_USED):[[:space:]]*(.*)$ ]]; then
        continue
      fi
      die "line $n: malformed property drawer"
    fi
    if [[ $line =~ ^-[[:space:]]+([^:]+)[[:space:]]+::[[:space:]]*(.*)$ ]]; then
      field["$current:${BASH_REMATCH[1]}"]=1
      field_value["$current:${BASH_REMATCH[1]}"]=${BASH_REMATCH[2]}
    fi
  done < "$plan"
  (( current >= 0 )) && ends[$current]=$n
  for key in "${metadata[@]}"; do [[ ${meta[$key]:-0} == 1 ]] || die "metadata $key must appear exactly once"; done
  (( count > 0 )) || die 'no executable headings'
  local i x skill_ref
  local skill_list_pattern='^\$[A-Za-z0-9][A-Za-z0-9._:-]*( \$[A-Za-z0-9][A-Za-z0-9._:-]*)*$'
  local -a skill_refs=()
  declare -A skill_seen=()
  for ((i=0; i<count; i++)); do
    [[ ${ends[$i]} != 0 ]] || ends[$i]=$n
    # ID was intentionally captured per heading into a line-indexed field.
    id=$(sed -n "$((starts[$i]+1)),$((ends[$i]))p" "$plan" | awk '/^:ID:[[:space:]]*/ {sub(/^:ID:[[:space:]]*/, ""); print; exit}')
    [[ $id =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "line ${lines[$i]}: missing or invalid ID"
    [[ -z ${seen[$id]:-} ]] || die "line ${lines[$i]}: duplicate ID $id"; seen[$id]=$i; ids[$i]=$id
    if (( levels[$i] == 1 )); then
      [[ ${review_status_count[$i]:-0} == 1 ]] || die "line ${lines[$i]} ($id): missing REVIEW_STATUS"
      [[ ${skills_count[$i]:-0} == 1 ]] || die "line ${lines[$i]} ($id): missing SKILLS"
      [[ ${skills[$i]} =~ $skill_list_pattern ]] || die "line ${lines[$i]} ($id): invalid SKILLS"
      read -r -a skill_refs <<< "${skills[$i]}"
      skill_seen=()
      for skill_ref in "${skill_refs[@]}"; do
        [[ -z ${skill_seen[$skill_ref]:-} ]] || die "line ${lines[$i]} ($id): duplicate skill reference $skill_ref"
        skill_seen[$skill_ref]=1
      done
      for x in Effort Goal Notes; do [[ ${field[$i:$x]:-} == 1 ]] || die "line ${lines[$i]} ($id): missing field $x"; done
    else
      for x in Why Change Tests; do [[ ${field[$i:$x]:-} == 1 ]] || die "line ${lines[$i]} ($id): missing field $x"; done
      [[ ${field[$i:Done when]:-} == 1 ]] || die "line ${lines[$i]} ($id): missing field Done when"
    fi
  done
  local wip_l1=0 wip_l2=0 parent
  for ((i=0; i<count; i++)); do
    if (( levels[$i] == 1 )); then [[ ${states[$i]} != WIP ]] || wip_l1=$((wip_l1+1)); continue; fi
    parent=${parents[$i]}
    [[ ${states[$parent]} != DONE || ${states[$i]} == DONE ]] || die "line ${lines[$i]} (${ids[$i]}): unfinished child of DONE parent"
    [[ ${states[$parent]} != TODO || ${states[$i]} == TODO ]] || die "line ${lines[$i]} (${ids[$i]}): active child outside WIP L1"
    [[ ${states[$i]} != WIP ]] || wip_l2=$((wip_l2+1))
  done
  (( wip_l1 <= 1 )) || die 'multiple WIP L1s'
  (( wip_l2 <= 1 )) || die 'multiple WIP L2s'
}
find_id() { local i; for ((i=0;i<count;i++)); do [[ ${ids[$i]} == "$1" ]] && { printf '%s' "$i"; return; }; done; return 1; }
print_item() { local i=$1; printf '%s %s [#%s] %s\n' "${levels[$i]#1}" "${ids[$i]}" "${states[$i]}" "${titles[$i]}"; }
active_l1() { local i; for ((i=0;i<count;i++)); do (( levels[$i] == 1 )) && [[ ${states[$i]} == WIP ]] && { printf '%s' "$i"; return; }; done; for ((i=0;i<count;i++)); do (( levels[$i] == 1 )) && [[ ${states[$i]} == TODO ]] && { printf '%s' "$i"; return; }; done; return 1; }

# Escape a Bash string as a JSON string body.  Keep UTF-8 bytes intact; JSON
# is UTF-8 and only ASCII control characters, quotes, and backslashes need
# escaping here.
json_escape() {
  local LC_ALL=C value=$1 character hex index output=
  for ((index=0; index<${#value}; index++)); do
    character=${value:index:1}
    case $character in
      '"') output+='\"' ;;
      \\) output+=$'\\\\' ;;
      $'\b') output+='\b' ;;
      $'\f') output+='\f' ;;
      $'\n') output+='\n' ;;
      $'\r') output+='\r' ;;
      $'\t') output+='\t' ;;
      [[:cntrl:]]) printf -v hex '%02X' "'$character"; output+="\\u00$hex" ;;
      *) output+=$character ;;
    esac
  done
  printf '%s' "$output"
}

# Native Codex plans are a compact display projection, so keep individual
# strings bounded even when an Org author supplies unusually long prose.
bounded_text() {
  local value=$1 limit=${2:-240}
  if (( ${#value} > limit )); then printf '%s…' "${value:0:limit-1}"; else printf '%s' "$value"; fi
}

projection() {
  local i j position=0 total=0 reviewed=0 active=0 active_index=-1 active_position=0 status title goal current_l2='' explanation l2_position l2_total
  local l1_position=0 active_details='' active_state
  for ((i=0; i<count; i++)); do (( levels[$i] == 1 )) && total=$((total + 1)); done
  for ((i=0; i<count; i++)); do
    (( levels[$i] == 1 )) || continue
    l1_position=$((l1_position + 1))
    [[ ${states[$i]} == DONE && ${review_status[$i]} == REVIEWED ]] && reviewed=$((reviewed + 1))
    if [[ ${states[$i]} == WIP || (${states[$i]} == DONE && ${review_status[$i]} == UNREVIEWED) ]]; then
      active=$((active + 1)); active_index=$i
      active_state=${states[$i]}
      [[ $active_state != DONE ]] || active_state='DONE + UNREVIEWED'
      active_details+="${active_details:+; }L1 $l1_position ${ids[$i]} ($active_state)"
    fi
  done
  (( active <= 1 )) || die "native projection has multiple in_progress L1 items: $active_details; review the earlier DONE + UNREVIEWED L1 before continuing the later WIP L1"
  if (( active_index >= 0 )); then
    for ((i=0; i<count; i++)); do (( levels[$i] == 1 && i <= active_index )) && active_position=$((active_position + 1)); done
    goal=${field_value[$active_index:Goal]:-${field_value[$active_index:Why]:-}}
    current_l2=''; l2_position=0; l2_total=0
    for ((j=0; j<count; j++)); do (( levels[$j] == 2 && parents[$j] == active_index )) && l2_total=$((l2_total + 1)); done
    for ((j=0; j<count; j++)); do
      (( levels[$j] == 2 && parents[$j] == active_index )) || continue
      l2_position=$((l2_position + 1))
      if [[ ${states[$j]} == WIP ]]; then current_l2="Current L2 $l2_position/$l2_total: ${titles[$j]} (${states[$j]})"; break; fi
      [[ -n $current_l2 || ${states[$j]} != TODO ]] || current_l2="Next L2 $l2_position/$l2_total: ${titles[$j]} (${states[$j]})"
    done
    [[ -n $current_l2 ]] || current_l2='All L2 milestones complete.'
    explanation="L1 $active_position/$total — ${titles[$active_index]}. Goal: $(bounded_text "$goal" 180). $current_l2"
    [[ ${states[$active_index]} != DONE ]] || explanation="Awaiting review. $explanation"
  else
    explanation="No L1 is active. $reviewed/$total L1 milestones are reviewed. Org state remains authoritative."
  fi
  printf '{"explanation":"%s","plan":[' "$(json_escape "$(bounded_text "$explanation")")"
  local first=1
  for ((i=0; i<count; i++)); do
    (( levels[$i] == 1 )) || continue
    position=$((position + 1))
    case "${states[$i]}:${review_status[$i]}" in
      TODO:*) status=pending ;;
      WIP:*) status=in_progress ;;
      DONE:UNREVIEWED) status=in_progress ;;
      DONE:REVIEWED) status=completed ;;
      *) die "invalid native projection state for ${ids[$i]}" ;;
    esac
    title="L1 $position/$total — ${titles[$i]}"
    (( first )) || printf ','; first=0
    printf '{"step":"%s","status":"%s"}' "$(json_escape "$(bounded_text "$title")")" "$status"
  done
  printf ']}\n'
}

canonical_plan_path() {
  local original=$1 path parent base target hops=0
  case $original in /*) path=$original ;; *) path=$PWD/$original ;; esac
  while [[ -L $path ]]; do
    (( hops < 40 )) || return 1
    target=$(readlink "$path") || return 1
    case $target in
      /*) path=$target ;;
      *) parent=${path%/*}; path=$parent/$target ;;
    esac
    hops=$((hops + 1))
  done
  parent=${path%/*}; base=${path##*/}; [[ -n $parent ]] || parent=/
  parent=$(cd -P -- "$parent" && pwd -P) || return 1
  printf '%s/%s' "$parent" "$base"
}

safe_status_directory() {
  local directory=$1 owner mode
  [[ -d $directory && ! -L $directory && -w $directory ]] || return 1
  owner=$(stat -c '%u' "$directory" 2>/dev/null || stat -f '%u' "$directory") || return 1
  mode=$(stat -c '%a' "$directory" 2>/dev/null || stat -f '%Lp' "$directory") || return 1
  [[ $owner == "$UID" && $mode =~ ^[0-7]+$ ]] || return 1
  (( (8#$mode & 8#22) == 0 ))
}

sha256_text() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  else
    printf 'sha256sum or shasum is required for plan status publication\n' >&2
    return 1
  fi
}

publish_plan_status() {
  local original=$1 reason=$2 status_file=${GESTALT_MOBILE_ORG_PLAN_STATUS_FILE:-}
  local status_directory=${GESTALT_MOBILE_ORG_PLAN_STATUS_DIRECTORY:-}
  local directory base tmp='' plan_path plan_id updated_at old_umask
  [[ -n $status_directory || -n $status_file ]] || return 0
  plan_path=$(canonical_plan_path "$original") || { printf 'cannot resolve plan path\n' >&2; return 1; }
  if [[ -n $status_directory ]]; then
    [[ $status_directory == /* ]] || { printf 'status directory must be absolute\n' >&2; return 1; }
    safe_status_directory "$status_directory" || { printf 'unsafe status file directory\n' >&2; return 1; }
    plan_id=$(sha256_text "$plan_path") || return 1
    status_file=$status_directory/$plan_id.plan-status.json
  fi
  [[ $status_file == /* ]] || { printf 'status file must be absolute\n' >&2; return 1; }
  directory=${status_file%/*}; base=${status_file##*/}
  [[ -n $directory && -n $base && $directory != "$status_file" ]] || { printf 'invalid status file path\n' >&2; return 1; }
  safe_status_directory "$directory" || { printf 'unsafe status file directory\n' >&2; return 1; }
  [[ ! -L $status_file ]] || { printf 'status file must not be a symlink\n' >&2; return 1; }
  [[ ! -e $status_file || -f $status_file ]] || { printf 'status file must be a regular file\n' >&2; return 1; }
  updated_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || { printf 'cannot create status timestamp\n' >&2; return 1; }
  old_umask=$(umask); umask 077
  tmp=$(mktemp "$directory/.${base}.tmp.XXXXXX") || { umask "$old_umask"; printf 'cannot create status file\n' >&2; return 1; }
  umask "$old_umask"
  trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
  if ! printf '{"schemaVersion":1,"planPath":"%s","reason":"%s","updatedAt":"%s"}\n' "$(json_escape "$plan_path")" "$(json_escape "$reason")" "$updated_at" >"$tmp"; then
    rm -f -- "$tmp"; trap - EXIT HUP INT TERM; return 1
  fi
  if ! mv -f -- "$tmp" "$status_file"; then
    rm -f -- "$tmp"; trap - EXIT HUP INT TERM; return 1
  fi
  trap - EXIT HUP INT TERM
}

publish_after_mutation() {
  local original=$1 reason=$2
  if ! publish_plan_status "$original" "$reason"; then
    printf 'warning: plan status not published\n' >&2
  fi
}

write_plan_candidate() {
  local original=$1 candidate=$2 reason=${3:-} mode
  mode=$(stat -c '%a' "$original" 2>/dev/null || stat -f '%Lp' "$original")
  chmod "$mode" "$candidate"
  parse "$candidate"
  mv "$candidate" "$original"
  trap - EXIT HUP INT TERM
  [[ -z $reason ]] || publish_after_mutation "$original" "$reason"
}

valid_model() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_profile_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

# Keep the generated role profiles aligned without duplicating this contract.
# shellcheck disable=SC2016 # Literal profile instructions must retain $org-plan.
attention_contract_requirements() {
  printf '%s' ' `gestalt_org_plan_attention` is an optional mobile dynamic tool, not an org-plan dependency; its current schema version is 1. First exhaust safe in-scope checks. When it is available, call it before yielding only for a genuine blocker, with a bounded summary and concrete requestedAction: material plan change uses planChange/planRevision; exhausted hard block uses hardBlock/externalStateChanged; unavailable required system capability or task skill uses missingDependency/dependencyInstalled; missing authority or permission uses permissionRequired/permissionGranted; changed external state uses externalState/externalStateChanged; unresolved material ambiguity uses materialAmbiguity/userGuidance. If it is unavailable, report the normal blocker concisely and do not treat it as a required dependency. A mobile autopilot checkpoint is synthetic control input: it never changes plan scope or review authority. On such a checkpoint, either call the tool for a table-qualified blocker or immediately resume the next legal Org Plan lifecycle action. Never call it for L1/L2 progress, child reports, waiting on a live child, review readiness, diagnosable or recoverable test failures, ordinary merge conflicts, token/context pressure, elapsed time, checkpointing, or an executor becoming idle.'
}

routing_contract_requirements() {
  printf '%s' ' The first tool call reads the org-plan skill completely and performs no other command; only after that standalone read returns may you inspect other guidance, the plan, or repository state. Use host-native filesystem tools for governing instructions, small bounded reads, edits, mutations, and short command interaction; use context-mode only for large or uncertain analysis, filtering, indexing, and retrieval. Context-mode never writes or changes Org state.'
}

written_profile=
profile_stage_dir=
profile_stage_owned=0
profile_installing=0
declare -a staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
cleanup_profile_stage() {
  [[ -n $profile_stage_dir ]] || return 0
  if (( profile_stage_owned )); then rm -rf -- "$profile_stage_dir"; else rmdir -- "$profile_stage_dir" 2>/dev/null || true; fi
  profile_stage_owned=0
}
rollback_profiles() {
  (( profile_installing )) || return 0
  local index
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    if [[ ${profile_had_destination[$index]} == 1 ]]; then
      cp -p -- "${profile_backups[$index]}" "${profile_destinations[$index]}"
    else
      rm -f -- "${profile_destinations[$index]}"
    fi
  done
  profile_installing=0
}
profile_exit_cleanup() { local status=$?; rollback_profiles; cleanup_profile_stage; return "$status"; }
profile_signal_cleanup() {
  local signal=$1 status
  case $signal in HUP) status=129 ;; INT) status=130 ;; TERM) status=143 ;; esac
  trap - HUP INT TERM
  rollback_profiles
  cleanup_profile_stage
  trap - EXIT
  exit "$status"
}
begin_profile_transaction() {
  local agents_dir=$1 suffix="${RANDOM}${RANDOM}"
  mkdir -p -- "$agents_dir"
  profile_stage_dir="$agents_dir/.org-plan-stage.$$.${suffix}"
  profile_stage_owned=0
  staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
  profile_installing=0
  trap profile_exit_cleanup EXIT
  trap 'profile_signal_cleanup HUP' HUP
  trap 'profile_signal_cleanup INT' INT
  trap 'profile_signal_cleanup TERM' TERM
  if mkdir -m 700 -- "$profile_stage_dir"; then
    profile_stage_owned=1
  else
    profile_stage_owned=0
    profile_stage_dir=
    return 1
  fi
}
finish_profile_transaction() {
  cleanup_profile_stage
  trap - EXIT HUP INT TERM
  profile_stage_dir=
  staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
}
stage_profile() {
  local profile_name=$1 description=$2 instructions=$3 model=$4 agents_dir=$5 sandbox_mode=${6:-} lifecycle_requirements=${7:-}
  local destination="$agents_dir/$profile_name.toml" temporary="$profile_stage_dir/$profile_name.toml" mode
  instructions+=$lifecycle_requirements
  mode=$(stat -c '%a' "$destination" 2>/dev/null || stat -f '%Lp' "$destination" 2>/dev/null || printf '600')
  if ! {
    printf 'name = "%s"\n' "$profile_name"
    printf 'description = "%s"\n' "$description"
    printf 'developer_instructions = "%s"\n' "$instructions"
    printf 'model = "%s"\n' "$model"
    [[ -z $sandbox_mode ]] || printf 'sandbox_mode = "%s"\n' "$sandbox_mode"
  } > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! chmod "$mode" "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  staged_profiles+=("$temporary")
}

prepare_profile_install() {
  local index destination backup
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    destination=${profile_destinations[$index]}
    backup="$profile_stage_dir/backup.$index"
    profile_backups+=("$backup")
    if [[ -f $destination ]]; then
      cp -p -- "$destination" "$backup"
      profile_had_destination+=(1)
    else
      profile_had_destination+=(0)
    fi
  done
}

validate_profile_destinations() {
  local destination
  for destination in "$@"; do
    [[ ! -L $destination && (! -e $destination || -f $destination) ]] || {
      printf 'profile destination is not a regular file: %s\n' "$destination" >&2
      return 1
    }
  done
}

# Percent-encode unsafe bytes so success records remain one-line key/value data.
encode_record_value() {
  local LC_ALL=C value=$1 output character hex index
  output=
  for ((index=0; index<${#value}; index++)); do
    character=${value:index:1}
    case $character in [A-Za-z0-9._~/-]) output+=$character ;; *) printf -v hex '%02X' "'$character"; output+="%$hex" ;; esac
  done
  printf '%s' "$output"
}

install_profiles() {
  local index
  profile_installing=1
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    mv -f -- "${staged_profiles[$index]}" "${profile_destinations[$index]}"
  done
  profile_installing=0
  finish_profile_transaction
}

write_profile() {
  local profile_name=$1 agents_dir=$5 destination="$5/$1.toml"
  validate_profile_destinations "$destination"
  begin_profile_transaction "$agents_dir"
  stage_profile "$@"
  profile_destinations=("$destination")
  prepare_profile_install
  install_profiles
  written_profile=$destination
}

prepare_executor() {
  local model='gpt-5.6-terra' profile_name='org-plan-executor' agents_dir="${HOME:?HOME is required}/.codex/agents"
  local lifecycle_requirements=' During supervised execution, direct TODO keyword or property edits are forbidden. Use org-plan set PLAN L1_ID WIP|DONE for L1 transitions and org-plan l2 PLAN L2_ID WIP|DONE for L2 transitions. Use org-plan next PLAN review and org-plan review PLAN L1_ID REVIEWED|UNREVIEWED for review selection and state. After any externally corrected plan file, run org-plan signal PLAN resync. After every successful authoring-start, supervision-start, set, l2, review, or resync helper action, report the mutation to the active root; executors never invoke host update_plan or create a competing native projection. Org Plan files are never Git deliverables: no user request, repository instruction, or release workflow overrides the ban on staging, committing, force-adding, cherry-picking, or otherwise introducing an Org Plan into Git history. Immediately before every accepted L1 commit, inspect git diff --cached --name-only; it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Status publication is optional when neither GESTALT_MOBILE_ORG_PLAN_STATUS_DIRECTORY nor the legacy GESTALT_MOBILE_ORG_PLAN_STATUS_FILE is present.'
  lifecycle_requirements+=$(attention_contract_requirements)
  lifecycle_requirements+=$(routing_contract_requirements)
  while (( $# )); do
    case $1 in
      --model) (( $# >= 2 )) || usage; model=$2; shift 2 ;;
      --agents-dir) (( $# >= 2 )) || usage; agents_dir=$2; shift 2 ;;
      --profile-name) (( $# >= 2 )) || usage; profile_name=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  valid_model "$model" || { printf 'invalid model: %s\n' "$model" >&2; return 2; }
  valid_profile_name "$profile_name" || { printf 'invalid profile name: %s\n' "$profile_name" >&2; return 2; }
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  write_profile "$profile_name" 'Executes an org-plan implementation.' \
    'You are the depth-one executor and the only code writer. Follow the assigned Org plan L1 strictly and report directly to the root director/reviewer. Before inspecting the repository or starting work, load the mandatory $gestalt:context-mode baseline, then verify every reference in that L1 SKILLS property is available, load exactly those declared task-specific skills, and load no other optional or task skill. The baseline never needs to appear in the Org plan SKILLS property. Stop without edits and report the unavailable reference if the baseline or any declared skill cannot be loaded. Before authoring, ensure a minimal valid skeleton and signal `org-plan signal PLAN authoring-start`; re-signal after coherent authoring edits. When implementation begins or resumes, signal `org-plan signal PLAN work-start`. These signals are safe no-ops outside Gestalt Mobile. Use the bundled org-plan helper for state changes and run required tests. Measure only with `org-plan measure start|checkpoint|finish PLAN ID SNAPSHOT_JSON`; never hand-edit derived properties. Start the L1, then each L2; checkpoint after every Org state mutation and at least every 60 seconds while active; finish each L2, then the L1. The assignment is the entire L1, not one L2. L2 completion, checkpoints, focused tests, progress updates, token usage, or elapsed time are non-terminal; immediately continue with the next actionable L2 and do not return a final report while implementation remains. Continue until the L1 is DONE with full-suite evidence and ready for root review. At that review boundary report evidence and await the root verdict; on REJECT resume the same L1 until it passes review. Keep implementation and review corrections uncommitted until the root explicitly ACCEPTS the L1. After ACCEPT, inspect git diff --cached --name-only: it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Org Plans are never Git deliverables; no user request, repository instruction, or release workflow overrides this ban. Create exactly one conventional commit only when that inspection is clean, then mark the L1 REVIEWED. Never create pre-review, fixup, or autosquash commits. Return only concise structured evidence to the root director/reviewer, never raw logs or complete transcripts.' \
    "$model" "$agents_dir" '' "$lifecycle_requirements"
  printf 'executor=%s model=%s profile=%s\n' "$profile_name" "$model" "$(encode_record_value "$written_profile")"
}

prepare_supervision() {
  local executor_model='gpt-5.6-terra' reviewer_model='gpt-5.6-sol'
  local executor_name='org-plan-executor' reviewer_name='org-plan-reviewer'
  local agents_dir="${HOME:?HOME is required}/.codex/agents"
  # Literal profile text intentionally includes backticked tool names.
  # shellcheck disable=SC2016
  local reporting_requirements=' Accepted-L1 reporting is a root-only turn boundary, not plan completion. Distinguish executor evidence, ACCEPT/REJECT review, an accepted-L1 report, and terminal whole-plan success. On ACCEPT, require staged-path inspection, exactly one conventional commit when changed, helper REVIEWED, projection, and host update_plan before reporting. Then, when `gestalt_org_plan_checkpoint` is available, call it once with l1Accepted and bounded plan/L1/commit metadata before one root final answer. Its exact form is `L<a>/TOTAL — TITLE: ACCEPTED`, then Completion, Review (including repaired REJECT findings), Verification (exact commands with bounded results), Commit (subject before optional hash or no commit required), and Next. Never expose executor output, raw logs, child transcripts, or duplicate finals to the user. An accepted final L1 still ends only its root turn: a later Autopilot continuation starts terminal review. Only after terminal review accepts the whole branch, P0/P1 corrections and their commit if needed, final gates, residual P2-or-lower findings, and clean intended scope may the root optionally call gestalt_org_plan_checkpoint once with terminalReviewAccepted and emit terminal success. If the optional checkpoint tool is absent, preserve all review, commit, projection, single-writer, and terminal-review gates; use safe legacy continuous-root behavior and never end early after the final L1. The earlier instruction to keep the root active applies until this legal accepted-L1 boundary and does not prohibit it.'
  local lifecycle_requirements=' Before the first L1, run org-plan signal PLAN supervision-start. During supervised execution, direct TODO keyword or property edits are forbidden. Require the executor to use org-plan set PLAN L1_ID WIP|DONE and org-plan l2 PLAN L2_ID WIP|DONE for all state transitions, retain org-plan next PLAN review and org-plan review PLAN L1_ID REVIEWED|UNREVIEWED for review selection and state, and run org-plan signal PLAN resync after any externally corrected plan file. After every successful authoring-start, supervision-start, set, l2, review, or resync helper action, the active root runs org-plan projection PLAN and makes the host-owned update_plan call with its exact plan items, reporting the companion explanation separately. Executors report mutations and never invoke host update_plan or create a competing native projection. If update_plan is absent or fails, warn once, keep Org state authoritative, and retry only at the next lifecycle boundary; Bash and MCP code never invoke it. Org Plan files are never Git deliverables: no user request, repository instruction, or release workflow overrides the ban on staging, committing, force-adding, cherry-picking, or otherwise introducing an Org Plan into Git history. Immediately before every accepted L1 commit, inspect git diff --cached --name-only; it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Status publication is optional when neither GESTALT_MOBILE_ORG_PLAN_STATUS_DIRECTORY nor the legacy GESTALT_MOBILE_ORG_PLAN_STATUS_FILE is present.'
  lifecycle_requirements+=$(attention_contract_requirements)
  lifecycle_requirements+=$(routing_contract_requirements)
  while (( $# )); do
    case $1 in
      --executor-model) (( $# >= 2 )) || usage; executor_model=$2; shift 2 ;;
      --reviewer-model) (( $# >= 2 )) || usage; reviewer_model=$2; shift 2 ;;
      --agents-dir) (( $# >= 2 )) || usage; agents_dir=$2; shift 2 ;;
      --executor-profile-name) (( $# >= 2 )) || usage; executor_name=$2; shift 2 ;;
      --reviewer-profile-name) (( $# >= 2 )) || usage; reviewer_name=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  local value
  for value in "$executor_model" "$reviewer_model"; do
    valid_model "$value" || { printf 'invalid model: %s\n' "$value" >&2; return 2; }
  done
  for value in "$executor_name" "$reviewer_name"; do
    valid_profile_name "$value" || { printf 'invalid profile name: %s\n' "$value" >&2; return 2; }
  done
  [[ $executor_name != "$reviewer_name" ]] || {
    printf 'profile names must be distinct\n' >&2; return 2;
  }

  local -a destinations=(
    "$agents_dir/$reviewer_name.toml"
    "$agents_dir/$executor_name.toml"
  )
  validate_profile_destinations "${destinations[@]}"
  begin_profile_transaction "$agents_dir"
  profile_destinations=("${destinations[@]}")
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  stage_profile "$reviewer_name" 'Directs, supervises, and reviews an org-plan implementation.' \
    'You are the depth-zero read-only director/reviewer/supervisor in the user conversation. Before any work, load the mandatory $gestalt:context-mode baseline; it never needs to appear in an Org plan SKILLS property. Stop and report the missing baseline if it is unavailable. Treat the loaded skill directory and the exact plan path supplied by the user, host, or authoring handoff as authoritative startup inputs. Reuse the exact supplied plan path. Do not rediscover it with find or rg, and do not substitute a repository-local .gestalt path. Do not probe helper source or help before starting. Resolve scripts/org-plan beneath the loaded skill directory once and verify it is executable. Do not run prepare-supervision during ordinary supervised execution. It is setup-only and gestalt-setup.sh owns role-profile installation. If the helper or plan input is absent, stop with that single missing prerequisite instead of trying speculative paths. This is the recommended root launch profile. Own user communication and directly spawn exactly one fresh depth-one org-plan executor per L1. Use one-based canonical positions everywhere: L1 position a is L<a> and its L2 child position b is L<a>.<b>. IDs remain helper arguments. Name the L<a> executor with collaboration-safe task_name l<a>; a dedicated L<a>.<b> agent uses l<a>_<b>. Refer to agents and milestones by canonical uppercase labels in assignments, reviews, commits, and user updates. Never spawn an intermediate supervisor or a separate routine L1 reviewer; the required terminal whole-branch reviewer is the sole exception. Never write code, edit files, modify the plan, or commit. Keep one executor active and keep the root active. Supervision is a completion loop, not a report relay. After every executor report, inspect the executor current state. If its L1 is partial and the executor stopped or became idle, call followup_task on that same executor before returning any root response. If the user asks for status, answer briefly and perform that continuation in the same turn; a status reply never consumes the required supervision action. Review only the DONE + UNREVIEWED L1 selected by `org-plan next PLAN review`; otherwise take the next eligible lifecycle action: finish the accepted L1 or launch the next L1. Treat an L2 completion, checkpoint, focused test, partial report, idle executor, self-described pause, token notice, or elapsed-time notice as non-terminal; never turn it into a final user response or wait for progress approval. Continue until every L1 is DONE and REVIEWED and final gates pass. Stop early only for a genuine external blocker that cannot be resolved without user input, new authority, or changed external state. Validate the exact plan once, then signal `org-plan signal PLAN supervision-start` before the first L1. Before each L1, confirm the preceding L1 is REVIEWED, terminate the prior executor, resolve the next L1 with `org-plan describe`, and include its exact Skills list and starting commit in a standalone executor assignment. Require the executor to load $gestalt:context-mode and exactly the declared task-specific skills before repository inspection; unavailable requirements block without edits. Require a minimal valid skeleton before `org-plan signal PLAN authoring-start`, a re-signal after coherent authoring edits, and `org-plan signal PLAN work-start` whenever implementation begins or resumes. Require measurement only through `org-plan measure start|checkpoint|finish PLAN ID SNAPSHOT_JSON`, with checkpoints after every Org state mutation and at least every 60 seconds while active. Require focused evidence after each L2 and a current full-suite pass plus intended dirty scope before L1 review. Review only the L1 selected by `org-plan next PLAN review`. Independently inspect its uncommitted diff against the starting commit, Goal, Tests, Done-when criteria, shared-code regression impact, and named evidence, then return an explicit ACCEPT or REJECT verdict directly to the executor. On REJECT, keep the L1 UNREVIEWED and direct the same executor to correct the same uncommitted diff before repeating the gates. On ACCEPT, require inspection of git diff --cached --name-only; it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Org Plans are never Git deliverables; no user request, repository instruction, or release workflow overrides this ban. Direct the executor to create exactly one conventional commit only when that inspection is clean, then mark the L1 REVIEWED; verify the commit subject and scope before terminating it and selecting the next L1. Never request fixup or autosquash commits. Skip already REVIEWED L1s without re-auditing them. After every L1 is DONE and REVIEWED, terminate the last executor and spawn one fresh depth-one subagent with fork_turns=none, agent_type=worker, model=gpt-5.6-sol, and task_name=final_review. Give it a general overview of the implemented Org Plan: plan goal, all L1/L2 outcomes, branch base, current HEAD, milestone commits, tests, known tradeoffs, and exact plan path as read-only context. Require a severity-ranked whole-branch review of all implementation work against the complete Org Plan. If it reports any P0 or P1 issue, order that same subagent to become the sole writer, fix every P0/P1, add regression coverage, run focused and full-suite checks, and report the correction diff and evidence. Independently review its corrections; after acceptance direct one conventional final-review correction commit that excludes the active Org Plan and every .gestalt/*.org path. P2 and lower findings may remain reported. Final acceptance requires this terminal review, no unresolved P0/P1, a current root-side full-suite pass, and clean intended scope. Show brief user-facing status at supervision start and when an L1 starts, reaches review, is rejected, is accepted, or blocks. Use `L<a>/TOTAL — TITLE: STATUS`; on first mention include Goal or Why and Skills. On first commit mention report its conventional subject and purpose before an optional short hash. Run potentially large inspections, tests, and log processing through context-mode so raw output does not enter conversational context; keep short fixed-output observations direct. Never expose raw logs or complete executor transcripts to the user. Render routine review verdicts autonomously and ask the user only for material ambiguity or an unavailable prerequisite.' \
    "$reviewer_model" "$agents_dir" 'read-only' "$lifecycle_requirements$reporting_requirements"
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  stage_profile "$executor_name" 'Executes an org-plan implementation.' \
    'You are the depth-one executor and the only code writer. Implement only the assigned Org plan L1 and report directly to the root director/reviewer. Before inspecting the repository or starting work, load the mandatory $gestalt:context-mode baseline, then verify every reference in the assigned L1 Skills list is available, load exactly those declared task-specific skills, and load no other optional or task skill. The baseline never needs to appear in the Org plan Skills list. Stop without edits and report the unavailable reference if the baseline or any declared skill cannot be loaded. Before authoring, ensure a minimal valid skeleton and signal `org-plan signal PLAN authoring-start`; re-signal after coherent authoring edits. When implementation begins or resumes, signal `org-plan signal PLAN work-start`. These signals are safe no-ops outside Gestalt Mobile. Use the bundled helper for state changes, preserve assigned scope, and run required tests. Measure only with `org-plan measure start|checkpoint|finish PLAN ID SNAPSHOT_JSON`; never hand-edit derived properties. Start the L1, then each L2; checkpoint after every Org state mutation and at least every 60 seconds while active; finish each L2, then the L1. The assignment is the entire L1, not one L2. L2 completion, checkpoints, focused tests, progress updates, token usage, or elapsed time are non-terminal; immediately continue with the next actionable L2 and do not return a final report while implementation remains. Continue until the L1 is DONE with full-suite evidence and ready for root review. At that review boundary report evidence and await the root verdict; on REJECT resume the same L1 until it passes review. Keep all implementation and review-correction changes uncommitted until the root explicitly ACCEPTS the L1. On REJECT, correct the same uncommitted diff and repeat the requested gates. After ACCEPT, inspect git diff --cached --name-only: it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Org Plans are never Git deliverables; no user request, repository instruction, or release workflow overrides this ban. Create exactly one conventional commit only when that inspection is clean. Then mark it REVIEWED. Never create pre-review, fixup, or autosquash commits. Return only concise structured evidence to the root director/reviewer, never raw logs or complete transcripts.' \
    "$executor_model" "$agents_dir" '' "$lifecycle_requirements"
  prepare_profile_install
  install_profiles
  local reviewer_path executor_path
  reviewer_path=$(encode_record_value "${destinations[0]}")
  executor_path=$(encode_record_value "${destinations[1]}")
  printf 'root_reviewer=%s root_reviewer_model=%s root_reviewer_profile=%s executor=%s executor_model=%s executor_profile=%s\n' \
    "$reviewer_name" "$reviewer_model" "$reviewer_path" \
    "$executor_name" "$executor_model" "$executor_path"
}

cmd=${1:-}
case $cmd in
  --help|-h) show_help; exit 0 ;;
  help)
    if (( $# == 1 )); then show_help; exit 0; fi
    (( $# == 2 )) || usage
    show_command_help "$2" || usage
    exit 0
    ;;
  '') usage ;;
esac
if (( $# == 2 )) && [[ $2 == --help || $2 == -h ]]; then
  show_command_help "$cmd" || usage
  exit 0
fi
shift
case $cmd in
  prepare-executor) prepare_executor "$@" ;;
  prepare-supervision) prepare_supervision "$@" ;;
  validate) [ $# = 1 ] || usage; parse "$1" ;;
  next)
    [ $# = 2 ] || usage; parse "$1"; case $2 in
      l1) i=$(active_l1) || exit 1; print_item "$i" ;;
      l2) p=$(active_l1) || exit 1; for ((i=0;i<count;i++)); do (( levels[$i] == 2 && parents[$i] == p )) && [[ ${states[$i]} == WIP ]] && { print_item "$i"; exit; }; done; for ((i=0;i<count;i++)); do (( levels[$i] == 2 && parents[$i] == p )) && [[ ${states[$i]} == TODO ]] && { print_item "$i"; exit; }; done; exit 1 ;;
      review) for ((i=0;i<count;i++)); do (( levels[$i] == 1 )) && [[ ${states[$i]} == DONE && ${review_status[$i]} == UNREVIEWED ]] && { print_item "$i"; exit; }; done; exit 1 ;;
      *) usage;; esac ;;
  summary|status)
    [ $# = 1 ] || usage; parse "$1"
    for s in TODO WIP DONE; do n=0; for ((i=0;i<count;i++)); do (( levels[i] == 1 )) && [[ ${states[i]} == "$s" ]] && n=$((n+1)); done; printf 'L1 %s=%s\n' "$s" "$n"; done
    for s in TODO WIP DONE; do n=0; for ((i=0;i<count;i++)); do (( levels[i] == 2 )) && [[ ${states[i]} == "$s" ]] && n=$((n+1)); done; printf 'L2 %s=%s\n' "$s" "$n"; done
    i=$(active_l1) && { printf 'current '; print_item "$i"; }
    for s in REVIEWED UNREVIEWED; do n=0; for ((i=0;i<count;i++)); do (( levels[i] == 1 )) && [[ ${review_status[i]} == "$s" ]] && n=$((n+1)); done; printf 'L1 %s=%s\n' "$s" "$n"; done ;;
  describe)
    [ $# = 2 ] || usage; parse "$1"; target=$(find_id "$2") || die "unknown ID $2"
    if (( levels[$target] == 1 )); then
      label=Goal; position=0; total=0
      for ((i=0;i<count;i++)); do
        (( levels[$i] == 1 )) || continue
        total=$((total + 1)); (( i != target )) || position=$total
      done
      printf 'L1 %s/%s %s\n%s: %s\nSkills: %s\n' "$position" "$total" "${titles[$target]}" "$label" "${field_value[$target:$label]}" "${skills[$target]}"
    else
      label=Why
      printf 'L2 %s\n%s: %s\n' "${titles[$target]}" "$label" "${field_value[$target:$label]}"
    fi ;;
  projection)
    [ $# = 1 ] || usage; parse "$1"; projection "$1" ;;
  review)
    [ $# = 3 ] || usage; original=$1; parse "$original"; target=$(find_id "$2") || die "unknown ID $2"; new=$3
    (( levels[$target] == 1 )) || die "ID $2 is not an L1"
    [[ $new =~ ^(UNREVIEWED|REVIEWED)$ ]] || usage
    [[ $new != REVIEWED || ${states[$target]} == DONE ]] || die "cannot review unfinished L1 $2"
    tmp=$(mktemp "${original}.tmp.XXXXXX"); trap 'rm -f "$tmp"' EXIT HUP INT TERM
    awk -v line="${review_lines[$target]}" -v status="$new" 'NR==line { sub(/UNREVIEWED|REVIEWED/, status) } {print}' "$original" > "$tmp"
    write_plan_candidate "$original" "$tmp" "review:$2:$new" ;;
  l2)
    if [ $# = 3 ]; then
      original=$1; parse "$original"; target=$(find_id "$2") || die "unknown ID $2"; new=$3
      (( levels[$target] == 2 )) || die "ID $2 is not an L2"
      [[ $new =~ ^(WIP|DONE)$ ]] || usage
      old=${states[$target]}
      [[ ($old == TODO && $new == WIP) || ($old == WIP && $new == DONE) ]] || die "invalid transition $old -> $new"
      tmp=$(mktemp "${original}.tmp.XXXXXX"); trap 'rm -f "$tmp"' EXIT HUP INT TERM
      awk -v line="${lines[$target]}" -v state="$new" 'NR==line { sub(/TODO|WIP|DONE/, state) } {print}' "$original" > "$tmp"
      write_plan_candidate "$original" "$tmp" "l2:$2:$new"
    elif [ $# = 2 ]; then
      parse "$1"; grep -E -- "$2" /dev/null >/dev/null 2>&1 || { [ $? = 1 ] || die 'invalid regular expression'; }
      matched=0; for ((i=0;i<count;i++)); do (( levels[i] == 2 )) || continue; block=$(sed -n "${starts[$i]},${ends[$i]}p" "$plan"); if printf '%s\n' "$block" | grep -E -q -- "$2"; then printf '%s\n' "$block"; matched=1; fi; done; (( matched )) || die 'no matching L2 blocks'
    else
      usage
    fi ;;
  set)
    if [ $# -lt 3 ] || [ $# -gt 4 ]; then usage; fi; original=$1; parse "$original"; target=$(find_id "$2") || die "unknown ID $2"; new=$3; force=${4:-}; [[ $new =~ ^(TODO|WIP|DONE)$ ]] || usage
    old=${states[$target]}; [[ -z $force || $force == --force ]] || usage
    if [[ -z $force ]]; then [[ ($old == TODO && $new == WIP) || ($old == WIP && $new == DONE) ]] || die "invalid transition $old -> $new"; fi
    if [[ -n $force ]]; then printf 'force: overriding %s -> %s\n' "$old" "$new" >&2; fi
    reset_review=0; (( levels[$target] != 1 )) || [[ $new != WIP || ${review_status[$target]} != REVIEWED ]] || reset_review=1
    tmp=$(mktemp "${original}.tmp.XXXXXX"); trap 'rm -f "$tmp"' EXIT HUP INT TERM
    awk -v line="${lines[$target]}" -v state="$new" -v reset_line="${review_lines[$target]:-0}" -v reset_review="$reset_review" '
      NR==line { sub(/TODO|WIP|DONE/, state) }
      reset_review && NR==reset_line { sub(/REVIEWED/, "UNREVIEWED") }
      {print}
    ' "$original" > "$tmp"
    write_plan_candidate "$original" "$tmp" "set:$2:$new" ;;
  measure)
    if [ $# -ne 4 ]; then usage; fi
    original=$2; parse "$original"; target=$(find_id "$3") || die "unknown ID $3"
    case $1 in start|checkpoint|finish) ;; *) usage ;; esac
    tmp=$(mktemp "${original}.tmp.XXXXXX"); trap 'rm -f "$tmp"' EXIT HUP INT TERM
    node "$(dirname "$0")/measure-plan.mjs" "$1" "$original" "$3" "$4" > "$tmp"
    write_plan_candidate "$original" "$tmp" "measure:$1:$3" ;;
  signal)
    if [ $# -lt 1 ] || [ $# -gt 2 ]; then usage; fi
    original=$1; parse "$original"
    publish_plan_status "$original" "${2:-signal}" || exit 1
    printf 'signal=published plan=%s reason=%s\n' "$(encode_record_value "$(canonical_plan_path "$original")")" "$(encode_record_value "${2:-signal}")" ;;
  supervision-start)
    [ $# = 1 ] || usage
    original=$1; parse "$original"
    publish_plan_status "$original" supervision-start || exit 1
    printf 'signal=published plan=%s reason=supervision-start\n' "$(encode_record_value "$(canonical_plan_path "$original")")" ;;
  *) usage ;;
esac
